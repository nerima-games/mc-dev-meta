{
  // Editor / language-server default project: everything in the repository.
  // CI gates use tsconfig.build.json (the pure layer) and tsconfig.test.json
  // (scripts + tests); this file exists so that opening any file in an editor
  // resolves against the same options.
  //
  // `repos/` is excluded everywhere: those are 15 separate projects with their
  // own tsconfigs, and type-checking them from here would be both wrong and
  // extremely slow.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "repos", "coverage", "dist"]
}
