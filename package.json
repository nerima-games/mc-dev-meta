{
  "name": "@nerima-games/mc-dev-meta",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Development-time workspace binder for the nerima-games Minecraft-clone rebuild: clones the 15 game repositories into repos/ and binds them into one pnpm workspace, with a committed manifest pinning each revision. Never published.",
  "homepage": "https://github.com/nerima-games/mc-dev-meta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-dev-meta.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-dev-meta/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "minecraft",
    "typescript",
    "pnpm-workspace",
    "monorepo",
    "tooling"
  ],
  "scripts": {
    "sync": "tsx scripts/sync-repos.ts",
    "sync:dry": "tsx scripts/sync-repos.ts --dry-run",
    "sync:latest": "tsx scripts/sync-repos.ts --latest",
    "sync:latest:dry": "tsx scripts/sync-repos.ts --latest --dry-run",
    "update:manifest": "tsx scripts/update-manifest.ts",
    "update:manifest:dry": "tsx scripts/update-manifest.ts --dry-run",
    "update:manifest:latest": "tsx scripts/update-manifest.ts --latest",
    "update:manifest:latest:dry": "tsx scripts/update-manifest.ts --latest --dry-run",
    "check:workspace": "tsx scripts/check-workspace.ts",
    "check:api-window": "tsx scripts/check-api-lock-window.ts",
    "check:mirrors": "tsx scripts/check-mirrors.ts",
    "check:repoint": "tsx scripts/check-repoint.ts",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "oxlint --deny-warnings index.ts domain scripts test",
    "lint:fix": "oxlint --fix index.ts domain scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:deps": "tsx scripts/check-dependency-whitelist.ts",
    "api:check": "tsx scripts/api-lock.ts",
    "api:update": "tsx scripts/api-lock.ts --write",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm api:check && pnpm check:mirrors && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
